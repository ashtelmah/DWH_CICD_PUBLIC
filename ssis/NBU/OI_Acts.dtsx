    <DTS:Executable
      DTS:refId="Package\UpdateProducts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2338709B-2E78-434D-B373-599AC2C48FEC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="UpdateProducts"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="-- DMS UPDATE&#xA;UPDATE OI_Acts&#xA;SET ProductGid= a.gid&#xA;From (&#xA;Select a.oabarcode, gid from Himalia..Products p &#xA;Inner join OI_Acts a ON a.[policy_ser]=p.id and a.t1_ovname='ДМС'&#xA;) a&#xA;Inner Join OI_Acts b ON b.oabarcode=a.oabarcode&#xA;GO&#xA;&#xA;-- OTHER&#xA;&#xA;&#xA;UPDATE OI_Acts&#xA;SET ProductGid= a.gid&#xA;From (&#xA;Select a.oabarcode, gid from Himalia..Products p &#xA;Inner join OI_Acts a ON a.polis_id=p.id &#xA;Where a.ProductGid is null&#xA;) a&#xA;Inner Join OI_Acts b ON b.oabarcode=a.oabarcode&#xA;GO&#xA;&#xA;-- SER + Number + Date&#xA;UPDATE OI_Acts&#xA;SET ProductGid= a.gid&#xA;From (&#xA;Select a.oabarcode, gid from Himalia..Products p &#xA;Inner Join OI_Acts a ON a.BeginningDate=p.BeginingDate&#xA;and p.PolisNumber like CAST(a.policy_ser+ '-' +a.PolisNumber as varchar(50))&#xA;where a.ProductGid is null &#xA;) a&#xA;Inner Join OI_Acts b ON b.oabarcode=a.oabarcode&#xA;GO&#xA;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
