          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="UPDATE OI_Acts&#xA;SET BeneficiaryIpnEdrpo= a.InsurerInnEdrpo&#xA;From &#xA;(&#xA;SELECT &#xA;      [ActID],CodVidStrahuvannia&#xA;&#x9;  ,Case when [IPNContragent]='' then CAST( [EDRPOUContragent] as nvarchar(50)) &#xA;else CAST(Isnull([IPNContragent],[EDRPOUContragent]) as nvarchar(50)) &#xA;end [InsurerInnEdrpo]&#xA;    &#xA;  FROM [DataBus].[dbo].[IRPL0013_1CtoSolu]&#xA;  ) a&#xA;  Inner Join OI_Acts b on a.ActID=b.oabarcode and b.ProgramCode=a.CodVidStrahuvannia&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
