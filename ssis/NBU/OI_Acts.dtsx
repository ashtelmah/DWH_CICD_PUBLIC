  <DTS:Variables>
    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{4EFB9675-F022-4DBC-B923-BD2B730C7AD4}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT a.oabarcode,a.oa_t1id, a.oa_nomerdog PolisNumber,a.oa_datadogbeg BeginningDate&#xA;, a.oa_to_buh&#xA;, a.oa_odergzkpo IpnEdrpo&#xA;,a.oa_serdog policy_id&#xA;,get_word(ext_pkd, 2, 4, '-') polis_id,&#xA;    get_word(ext_pkd, 3, 4, '-') prg_id,&#xA;    get_word(ext_pkd, 4, 4, '-') obj_id&#xA;    &#xA;    , t.t1_vid ProgramCode&#xA;   &#xA;    , t.t1_ovname&#xA;FROM oa a&#xA;Inner Join T1 t ON a.oa_t1id=t.T1_id&#xA;where  a.oa_to_buh &gt;= to_date('01-01-2023','dd-MM-yyyy')&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="OI">
      <DTS:VariableValue
        DTS:DataType="8">SELECT a.oabarcode,a.oa_t1id, a.oa_nomerdog PolisNumber,a.oa_datadogbeg BeginningDate
, a.oa_to_buh
, a.oa_odergzkpo IpnEdrpo
,a.oa_serdog policy_id
,get_word(ext_pkd, 2, 4, '-') polis_id,
    get_word(ext_pkd, 3, 4, '-') prg_id,
    get_word(ext_pkd, 4, 4, '-') obj_id
    
    , t.t1_vid ProgramCode
   
    , t.t1_ovname
FROM oa a
Inner Join T1 t ON a.oa_t1id=t.T1_id
where  a.oa_to_buh &gt;= to_date('01-01-2023','dd-MM-yyyy')</DTS:VariableValue>
    </DTS:Variable>
  </DTS:Variables>
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\BeneFiciary"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2A8450DD-E178-4DD6-89E5-5771612F60DC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="BeneFiciary"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="&#xA;UPDATE OI_Acts&#xA;SET  BeneficiaryPersonTypeId=a.PersonTypeID&#xA;From (&#xA;&#xA;Select f.PersonTypeID, a.oabarcode from &#xA;(Select f.PersonTypeID ,&#xA;Case when f.IdentificationCode='' then f.EDRPOU&#xA;else Isnull(f.IdentificationCode,f.EDRPOU) &#xA;end [InsurerInnEdrpo]&#xA;From  Metis.dbo.Faces f) f&#xA;Inner Join OI_Acts a ON a.BeneficiaryIpnEdrpo=f.[InsurerInnEdrpo]&#xA;&#xA;) a&#xA;Inner Join OI_Acts b ON b.oabarcode=a.oabarcode&#xA;GO&#xA;&#xA;UPDATE [DataBus].[dbo].[OI_Acts]&#xA;  SET BeneficiaryPersonTypeId=2&#xA;  Where  Len(BeneficiaryIpnEdrpo) &lt;9&#xA;  and BeneficiaryPersonTypeId is null&#xA;  GO&#xA;   UPDATE [DataBus].[dbo].[OI_Acts]&#xA;  SET BeneficiaryPersonTypeId=1&#xA;  Where  Len(BeneficiaryIpnEdrpo) &gt;8&#xA;  and BeneficiaryPersonTypeId is null&#xA;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute SQL Task"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{BD71D5DC-64AA-4E98-B83C-96B169A71331}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute SQL Task"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="Truncate table OI_Acts&#xA;go" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\H015"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{332E823D-731A-40AD-A781-A0977950795A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="H015"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="UPDATE OI_Acts&#xA;SET H015= z.H015&#xA;From&#xA;(&#xA; Select oabarcode,&#xA;  CASE &#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId=1 AND InsurerInnEdrpo=ContragentInnEdrpo&#xA;then '6'&#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId=1 AND InsurerInnEdrpo&lt;&gt;ContragentInnEdrpo&#xA;then 'A'&#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId  in (2 ,3)&#xA;then 'B'&#xA;when PersonTypeId in (2 ,3) AND  BeneficiaryPersonTypeId  in (2 ,3) AND InsurerInnEdrpo=ContragentInnEdrpo&#xA;then '5'&#xA;when PersonTypeId  in (2 ,3) AND  BeneficiaryPersonTypeId  in (2 ,3) AND InsurerInnEdrpo&lt;&gt;ContragentInnEdrpo&#xA;then 'B'&#xA;when PersonTypeId in (2 ,3)  AND  BeneficiaryPersonTypeId=1 &#xA;then 'A'&#xA;End H015&#xA;From &#xA;(&#xA;Select a.oabarcode, a.InsurerInnEdrpo,a.PersonTypeId, a.BeneficiaryPersonTypeId&#xA; ,Case when s.IPNContragent='' then s.EDRPOUContragent&#xA;else Isnull(s.IPNContragent,s.EDRPOUContragent) &#xA;end [ContragentInnEdrpo]&#xA; from OI_Acts a&#xA; Inner Join IRPL0013_1CtoSolu s ON a.oabarcode=s.ActID&#xA; ) y&#xA; )z&#xA; INNER JOIN OI_Acts b ON b.oabarcode=z.oabarcode&#xA;&#xA;&#xA; GO&#xA; UPDATE OI_Acts&#xA;SET H015= z.H015&#xA;From&#xA;(&#xA; Select oabarcode,&#xA;  CASE &#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId=1 AND InsurerInnEdrpo=BeneficiaryIpnEdrpo&#xA;then '6'&#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId=1 AND InsurerInnEdrpo&lt;&gt;BeneficiaryIpnEdrpo&#xA;then 'A'&#xA;when PersonTypeId=1 AND  BeneficiaryPersonTypeId in (2 ,3)&#xA;then 'B'&#xA;when PersonTypeId in (2 ,3) AND  BeneficiaryPersonTypeId in (2 ,3) AND InsurerInnEdrpo=BeneficiaryIpnEdrpo&#xA;then '5'&#xA;when PersonTypeId in (2 ,3) AND  BeneficiaryPersonTypeId in (2 ,3) AND InsurerInnEdrpo&lt;&gt;BeneficiaryIpnEdrpo&#xA;then 'B'&#xA;when PersonTypeId in (2 ,3) AND  BeneficiaryPersonTypeId=1 &#xA;then 'A'&#xA;End H015&#xA;From &#xA;(&#xA;Select a.oabarcode, a.InsurerInnEdrpo,a.PersonTypeId, a.BeneficiaryPersonTypeId&#xA; ,a.BeneficiaryIpnEdrpo&#xA; from OI_Acts a&#xA;  ) y&#xA; )z&#xA; INNER JOIN OI_Acts b ON b.oabarcode=z.oabarcode&#xA; Where b.H015 is null&#xA;&#xA;&#xA;UPDATE [DataBus].[dbo].IRPL0013_1CtoSolu&#xA; SET  H015=a.H015&#xA; FROM&#xA;  (Select r.id   , m.H015 &#xA;  FROM [DataBus].[dbo].IRPL0013_1CtoSolu r&#xA;  Inner Join [DataBus].[dbo].[MedPayouts] m on m.ID_clime_act=r.ActID&#xA;  Where  r.H015=''&#xA;  )a, [DataBus].[dbo].IRPL0013_1CtoSolu b &#xA;  Where a.id=b.id&#xA;&#xA; UPDATE [DataBus].[dbo].IRPL0013_1CtoSolu&#xA;  SET H015=a.H015&#xA;  FROM&#xA;  (SELECT r.ID, '6' H015&#xA;  FROM [DataBus].[dbo].IRPL13 r&#xA;  Inner Join [DataBus].[dbo].IRPL0013_1CtoSolu s ON r.id=s.id&#xA;  where r.[H015]='' and r.H011='A2') a, [DataBus].[dbo].IRPL0013_1CtoSolu b&#xA;  Where a.id=b.id&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\H018"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{AEDC432C-4C86-4DA7-BBE8-A45B4072CF91}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="H018"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="&#xA; UPDATE OI_Acts&#xA; SET ProgramGid=a.gid&#xA; FROM&#xA; ( Select a.oabarcode, pg.gid&#xA;&#xA; FROM  Himalia..Products p &#xA; Inner Join Himalia..Programs pg on pg.ProductGID=p.gid&#xA; Inner Join Himalia.[meta].[ProgramTypes] pt ON pt.gid=pg.ProgramTypeGID&#xA; Inner Join  OI_Acts a ON a.ProductGid=p.gid and a.ProgramCode=pt.Code&#xA; )a&#xA; Inner join OI_Acts b ON  b.oabarcode= a.oabarcode&#xA;&#xA;GO&#xA;&#xA; UPDATE OI_Acts&#xA; SET  H011=b.H011&#xA; FROM [DataBus].[dbo].[OI_Acts] a&#xA;  Inner join IRPL0013_1CtoSolu b on a.oabarcode=b.ActID and a.ProgramCode=b.CodVidStrahuvannia&#xA;  Where a.H011&lt;&gt;b.H011 or a.H011 is null&#xA;&#xA;GO&#xA;&#xA;  &#xA; UPDATE OI_Acts&#xA; SET  H018=a.H018&#xA; FROM&#xA;  (Select a.oabarcode,a.ProgramCode&#xA;&#xA; , CASE &#xA;When b.H011 in ('A1','A2') and a.PersonTypeId=1 Then Cast ( '7'as nvarchar(2))&#xA;When b.H011 in ('A1','A2') and a.PersonTypeId in (2,3) Then Cast ( '8'as nvarchar(2))&#xA;Else Cast ( 'B'as nvarchar(2)) End H018 &#xA;   FROM [DataBus].[dbo].[OI_Acts] a&#xA;  Inner join IRPL0013_1CtoSolu b on a.oabarcode=b.ActID and a.ProgramCode=b.CodVidStrahuvannia&#xA;  )a&#xA;  Inner join DataBus.[dbo].[OI_Acts] b on a.oabarcode=b.oabarcode and a.ProgramCode=b.ProgramCode&#xA;   &#xA;&#xA;/*        Изменился вид страхования в Уране            */&#xA;&#xA; UPDATE OI_Acts&#xA; SET  H018=a.H018&#xA; FROM&#xA;  (Select distinct a.oabarcode,a.ProgramCode&#xA; , CASE &#xA;When b.H011 in ('A1','A2') and a.PersonTypeId=1 Then Cast ( '7'as nvarchar(2))&#xA;When b.H011 in ('A1','A2') and a.PersonTypeId in (2,3) Then Cast ( '8'as nvarchar(2))&#xA;Else Cast ( 'B'as nvarchar(2)) End H018 &#xA;   FROM [DataBus].[dbo].[OI_Acts] a&#xA;  Inner join IRPL0013_1CtoSolu b on a.oabarcode=b.ActID and b.CodVidStrahuvannia in (233,234) &#xA;  --and a.ProgramCode=b.CodVidStrahuvannia&#xA;  Where a.ProgramCode in (233,234)&#xA; &#xA;  and a.DateKey &gt; 20250101&#xA;  and a.H011&lt;&gt;b.H011 or a.H011 is null&#xA;&#xA;  )a&#xA;  Inner join DataBus.[dbo].[OI_Acts] b on a.oabarcode=b.oabarcode and b.H018 is null&#xA;  &#xA;&#xA;&#xA; UPDATE [DataBus].[dbo].IRPL0013_1CtoSolu&#xA; SET  H018=a.H018&#xA; FROM&#xA;  (Select r.id&#xA;&#xA; , CASE &#xA;When r.H011 in ('A1','A2') and m.InsurerType='Фіз. особа' Then Cast ( '7'as nvarchar(2))&#xA;When r.H011 in ('A1','A2') and m.InsurerType='Юр. особа'  Then Cast ( '8'as nvarchar(2))&#xA;Else Cast ( 'B'as nvarchar(2)) End H018 &#xA;  FROM [DataBus].[dbo].IRPL0013_1CtoSolu r&#xA;  Inner Join [DataBus].[dbo].[MedPayouts] m on m.ID_clime_act=r.ActID&#xA;  Where  H018=''&#xA;  )a, [DataBus].[dbo].IRPL0013_1CtoSolu b &#xA;  Where a.id=b.id&#xA;&#xA;&#xA;  UPDATE [DataBus].[dbo].IRPL0013_1CtoSolu&#xA;  SET H018=a.H018&#xA;  FROM&#xA;  (SELECT r.ID&#xA;,CASE When  r.H011='A2' then '7' else 'B' end H018 &#xA;  FROM [DataBus].[dbo].IRPL13 r&#xA;  Inner Join [DataBus].[dbo].IRPL0013_1CtoSolu s ON r.id=s.id&#xA;  where r.[H018]=''  ) a, [DataBus].[dbo].IRPL0013_1CtoSolu b&#xA;  Where a.id=b.id&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Insurer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1AC28807-92EA-4D71-BE75-576440415DF1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Insurer"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{953C2AD6-925A-4417-B3B8-B8245440B1C8}"
          SQLTask:SqlStatementSource="&#xA;UPDATE OI_Acts&#xA;SET InsurerFaceGID=a.InsurerFaceGID, PersonTypeId=a.PersonTypeID, [InsurerInnEdrpo]=a.InsurerInnEdrpo&#xA;,InsurerName=Left(a.Name,50)&#xA;From (&#xA;&#xA;select a.oabarcode, p.InsurerFaceGID,f.PersonTypeID, f.name&#xA;,Case when f.IdentificationCode='' then f.EDRPOU&#xA;else Isnull(f.IdentificationCode,f.EDRPOU) &#xA;end [InsurerInnEdrpo]&#xA;from Himalia..Products p &#xA;Inner Join OI_Acts a ON a.ProductGid=p.gid&#xA;Left join Metis.dbo.Faces f ON p.InsurerFaceGID=f.gid&#xA;) a&#xA;Inner Join OI_Acts b ON b.oabarcode=a.oabarcode&#xA;GO&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
