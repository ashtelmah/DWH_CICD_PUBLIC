              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Select C.id claim_id, Cast(C.Number as varchar) claim_no
, D.id act_id , CAST(D.Number as varchar) act_no
	,P.gid as ProductGid, CAST(C.PolisNumber as varchar(50)) PolisNumber 
	,CAST( PT.Code as varchar(5)) ProgramCode
	,P.InsurerFaceGID
	,f.PersonTypeID
, Left(f.Name,50)  InsurerName
	,Case when f.IdentificationCode='' then CAST( f.EDRPOU as varchar(50)) 
else CAST(Isnull(f.IdentificationCode,f.EDRPOU) as varchar(50)) 
end [InsurerInnEdrpo]
	from Oberon.dbo.Cases AS C 
	Inner join Oberon.dbo.CasesDocuments AS CD
	ON C.gid =CD.CaseGID
	INNER JOIN Oberon.dbo.Documents AS D
      ON D.gid = CD.DocumentGID
         AND D.Deleted = 0 
	INNER JOIN [DataBus].[dbo].[IRPL0013_1CtoSolu] db
	   	ON db.ActID = Cast(D.id as varchar(50))
	INNER JOIN Himalia..Products AS P ON P.PolisNumber =C.PolisNumber
	Inner Join Himalia..Programs pg on pg.ProductGID=p.gid
   Inner Join Himalia.[meta].[ProgramTypes] pt ON pt.gid=pg.ProgramTypeGID
	Inner Join Metis.dbo.Faces f on P.InsurerFaceGID=f.gid</property>
                <property
