      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EA537F56-00A2-4F72-A287-06454344BBDC}"
          SQLTask:SqlStatementSource="UPDATE b &#xA;SET PlanedSum = a.[ISUM]&#xA;FROM &#xA;(SELECT t.ProgramGid, SUM([ISUM]) [ISUM]&#xA;  FROM [DWHWarehouse].[fact].[TwhAcc] t &#xA;INNER JOIN  Accounts.dbo.PG7PG5_Stage_V1 a&#xA;ON t.ProgramGid = a.ProgramGid &#xA;and  a.PlanedSum=0 &#xA;and t.PgType in ('3.1')&#xA;GROUP BY t.ProgramGid&#xA;) a ,  Accounts.dbo.PG7PG5_Stage_V1 b &#xA;WHERE a.ProgramGid = b.ProgramGid &#xA;AND b.PlanedSum =0&#xA;&#xA;/*           2.1       */&#xA;&#xA;UPDATE b &#xA;SET PlanedSum = a.[ISUM]&#xA;FROM &#xA;(SELECT t.ProgramGid, SUM([ISUM]) [ISUM]&#xA;  FROM [DWHWarehouse].[fact].[TwhAcc] t &#xA;INNER JOIN  Accounts.dbo.PG7PG5_Stage_V1 a&#xA;ON t.ProgramGid = a.ProgramGid &#xA;and  a.PlanedSum=0 &#xA;and t.PgType in ('2.1')&#xA;GROUP BY t.ProgramGid&#xA;) a ,  Accounts.dbo.PG7PG5_Stage_V1 b &#xA;WHERE a.ProgramGid = b.ProgramGid &#xA;AND b.PlanedSum =0&#xA;&#xA;/*           InsClass                 */&#xA;&#xA;UPDATE b &#xA;SET InsClass = a.Code&#xA;From &#xA;( Select ProgramGid, ic.Code From Accounts.dbo.PG7PG5_Stage_V1 a&#xA;INNER JOIN OrantaSch.dbo.Programs pg on pg.GID=a.ProgramGid&#xA;Inner Join [OrantaSch].[meta].[ProgramTypes] pt ON pt.gid=pg.ProgramTypeGID&#xA;&#x9;Inner Join [OrantaSch].[meta].[InsuranceClasses] ic on ic.gid=pt.InsuranceClassGID&#xA;) a , Accounts.dbo.PG7PG5_Stage_V1 b&#xA;Where a.ProgramGid= b.ProgramGid&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
