	'Страхувальник' Initiators,
    --CAST ( FaceINN as nvarchar(20)) INNEDRPOU ,
    Period as DateKey
FROM  Accounts.dbo.PG7PG5_Stage_V1
GROUP BY 
    PolisNumber,
    InsType, InsClass,
    BeginingDate,
    CancelDate,
    Period,
    Comment</property>
