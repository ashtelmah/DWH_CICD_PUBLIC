                    <outputColumn
                      refId="Package\TwhAcc\OLE DB Source.Outputs[OLE DB Source Output].Columns[CancelDate]"
                      dataType="dbDate"
                      errorOrTruncationOperation="Conversion"
                      errorRowDisposition="FailComponent"
                      externalMetadataColumnId="Package\TwhAcc\OLE DB Source.Outputs[OLE DB Source Output].ExternalColumns[CancelDate]"
                      lineageId="Package\TwhAcc\OLE DB Source.Outputs[OLE DB Source Output].Columns[CancelDate]"
                      name="CancelDate"
                      truncationRowDisposition="FailComponent" />
                    <outputColumn
                      refId="Package\TwhAcc\OLE DB Source.Outputs[OLE DB Source Output].Columns[Payment]"
                      dataType="numeric"
                      errorOrTruncationOperation="Conversion"
