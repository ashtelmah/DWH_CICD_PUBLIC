              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">Declare @StartDat  int = ? , @EndDat int = ? 

SELECT
    a.PolisNumber,
    a.InsCode,
    a.BeginingDate,
    a.CancelDate,
	   SUM(ISNULL(x.SumISUM_11, 0)) AS Payment,
    SUM(a.ISUM) AS ReturnSum,
    COALESCE(NULLIF(f.IdentificationCode, ''), f.EDRPOU) AS INNEDRPOU,
    a.DateKey
 
FROM DWHWarehouse.fact.TwhAcc a
INNER JOIN OrantaSch.dbo.products p 
    ON a.ProductGid = p.gid
INNER JOIN Metis.dbo.Faces f 
    ON f.gid = p.InsurerFaceGID

OUTER APPLY (
    SELECT SUM(t2.ISUM) AS SumISUM_11
    FROM DWHWarehouse.fact.TwhAcc t2
    WHERE t2.ProgramGid = a.ProgramGid
      AND t2.PgType = '1.1'
      AND t2.DateKey &lt;= a.DateKey
) x

WHERE a.PgType IN ('7.2.1','7.3.1', '5.1')
   AND a.DateKey between @StartDat and  @EndDat

GROUP BY  a.PolisNumber, a.InsCode, a.BeginingDate, a.CancelDate, a.DateKey,
    COALESCE(NULLIF(f.IdentificationCode, ''), f.EDRPOU)
HAVING SUM(a.ISUM)  &lt;&gt; 0</property>
                <property
